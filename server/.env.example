DATABASE_URL=postgresql://antibrow@localhost:5433/antibrow
# 64 hex characters, Ed25519 seed used to sign engine license tokens
FP_LICENSE_PRIVKEY=

# Admin panel and admin API. OEM_ADMIN_PASSWORD is required: without it every
# admin route answers 404, bearer token included. OEM_ADMIN_TOKEN additionally
# lets scripts call /api/admin with `Authorization: Bearer`.
OEM_ADMIN_PASSWORD=
OEM_ADMIN_TOKEN=
OEM_SESSION_SECRET=

# S3 compatible storage (all four required together, or none)
S3_ENDPOINT=http://localhost:9000
# URL clients use for presigned uploads and downloads; defaults to S3_ENDPOINT.
# Set it when the server reaches storage over an internal address.
S3_PUBLIC_ENDPOINT=
S3_REGION=auto
# path (default) or virtual. Aliyun OSS requires virtual (bucket in the host name).
S3_ADDRESSING=path
S3_BUCKET=antibrow
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# 1 = the Docker entrypoint creates the bucket at start if missing
S3_CREATE_BUCKET=

OEM_PUBLIC_URL=https://api.example.com
OEM_BRAND_NAME=AntiBrow
KERNEL_MANIFEST_URL=https://download.antibrow.com/fp-browser-versions.json
APP_VERSIONS_KEY=app-versions.json
RECIPE_REGISTRY_URL=
